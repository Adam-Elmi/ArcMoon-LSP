{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ArcMoon extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}/../ArcMoon/example"
      ]
    }
  ]
}
